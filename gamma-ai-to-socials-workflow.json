    {
      "parameters": {
        "promptType": "define",
        "text": "=Create the VP Insider executive AI briefing for {{$json.target_period}}.\n\nNEWS ITEMS:\n{{$json.news_items}}\n\nOutput format:\n1) VP Insider AI Trends Briefing — {{$json.target_period}}\n2) Executive Summary (2–4 sentences)\n3) Top AI Developments (3–7 bullets: What happened → Why it matters → Action)\n4) Watchlist (2–4 developing AI risks/unknowns)\n5) Next 7 Days (3–5 strategic AI actions)",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are an executive AI strategy analyst with a mission to research and create a report that is optimized for business executives looking to learn AI insights and find ways to boost ROI when adding AI technology to their company's business processes.\n\nTIME RULE (NON-NEGOTIABLE):\n- The current period is {{$json.target_period}}.\n- Never imply a different 'current year' than {{$json.target_year}}.\n- If older items appear, label them 'Stale (outside {{$json.target_period}})' and do not anchor conclusions on them.\n\nQUALITY RULES:\n- No hype, no generic AI explanations.\n- Focus on the newest AI trends & connected technology breakthroughs, business impact (ROI, costs, etc.), competitive implications and strategic actions. Choose one of the most innovative of the content articles that are provided in the RSS Read source and highlight as part of the output."
            }
          ]
        },
        "batching": {
          "batchSize": 5
        }
      },
