    {
      "parameters": {
        "method": "POST",
        "url": "https://public-api.gamma.app/v1.0/generations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-KEY",
              "value": "YOUR_GAMMA_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{\n  JSON.stringify({\n    format: \"presentation\",\n    inputText: (\n      ($json.gamma_inputText || \"\")\n        // convert literal backslash-n into real newlines\n        .replaceAll(\"\\\\r\\\\n\", \"\\n\")\n        .replaceAll(\"\\\\n\", \"\\n\")\n        .replaceAll(\"\\\\r\", \"\\n\")\n\n        // enforce strong card breaks Gamma recognizes\n        .replace(/\\n{2,}/g, \"\\n\\n\")\n        .replace(/\\n(?=\\d+\\)\\s)/g, \"\\n\\n\")     // blank line before \"1) 2) 3)\"\n        .replace(/\\n\\n(?=\\d+\\)\\s)/g, \"\\n\\n---\\n\\n\") // separator between sections\n    ),\n    textMode: \"preserve\",\n    cardSplit: \"inputTextBreaks\"\n  })\n}}",
        "options": {}
      },
