    {
      "parameters": {
        "jsCode": "const raw = $json.text ?? \"\";\n\n// 1) Safely extract message (handles JSON-stringified LLM outputs)\nlet msg = raw;\ntry {\n  const parsed = JSON.parse(raw);\n  msg = (parsed?.message ?? parsed?.text ?? raw);\n} catch {}\n\n// 2) Normalize literal escaped newlines first, then normalize CRLF\nmsg = String(msg)\n  .replaceAll(\"\\\\\\\\r\\\\\\\\n\", \"\\n\")\n  .replaceAll(\"\\\\\\\\n\", \"\\n\")\n  .replaceAll(\"\\\\\\\\r\", \"\\n\")\n  .replaceAll(\"\\r\\n\", \"\\n\")\n  .replaceAll(\"\\r\", \"\\n\");\n\n// 3) Strip a common prefix if it appears\nmsg = msg.replace(/^=\\-\\s*/, \"\");\n\n// 4) Force Gamma-detectable \"text breaks\" (blank line paragraphing)\nmsg = msg\n  .replace(/\\n{3,}/g, \"\\n\\n\")          // collapse excessive spacing\n  .replace(/\\n-\\s/g, \"\\n\\n- \")         // blank line before bullets\n  .replace(/\\n(\\d+\\)\\s)/g, \"\\n\\n$1\");  // blank line before numbered sections like \"1) \"\n\n// 5) Build a safe period header (NO undefined)\nconst year =\n  $json.target_year ??\n  new Date().getFullYear();\n\nconst quarter =\n  $json.target_quarter ??\n  `Q${Math.floor(new Date().getMonth() / 3) + 1}`;\n\nconst targetPeriod =\n  $json.target_period ??\n  `${quarter} ${year}`;\n\n// Remove any existing TECH HIGHLIGHTS header (prevents duplicates)\nmsg = msg.replace(/^TECH HIGHLIGHTS.*\\n+/i, \"\");\n\n// Prepend correct header + a blank line\nmsg = `TECH HIGHLIGHTS — ${targetPeriod}\\n\\n${msg}`;\n\n// Final cleanup: ensure at least one paragraph break exists\nif (!msg.includes(\"\\n\\n\")) {\n  msg = msg.replace(/\\n/g, \"\\n\\n\");\n}\n\nreturn [{\n  json: {\n    ...$json,\n    gamma_inputText: msg,\n    target_year: year,\n    target_quarter: quarter,\n    target_period: targetPeriod,\n  }\n}];"
      },
