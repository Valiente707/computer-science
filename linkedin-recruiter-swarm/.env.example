# LinkedIn API Credentials
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here
LINKEDIN_ACCESS_TOKEN=your_access_token_here
LINKEDIN_API_KEY=your_api_key_here

# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=recruiter

# Optional: OpenAI for enhanced message generation
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4

# Optional: Anthropic Claude for message generation
ANTHROPIC_API_KEY=your_anthropic_key_here

# Environment
ENVIRONMENT=development  # development, staging, production
DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Rate Limiting
ENABLE_RATE_LIMITING=true
MAX_DAILY_OUTREACH=50

# Feature Flags
ENABLE_PARALLEL_SEARCH=true
ENABLE_ADAPTIVE_PIPELINE=true
ENABLE_AUTO_FOLLOWUP=true
