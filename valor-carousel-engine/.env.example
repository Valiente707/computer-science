# === AI APIs ===
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# === Image generation ===
IMAGE_MODEL=gpt-image-1.5        # or gpt-image-1, gpt-image-1-mini
IMAGE_SIZE=1024x1536              # 9:16 portrait — required for TikTok
IMAGE_QUALITY=medium              # low | medium | high

# === Postiz ===
POSTIZ_API_KEY=pos_xxx
POSTIZ_BASE_URL=https://api.postiz.com/public/v1
POSTIZ_TIKTOK_INTEGRATION_ID=xxx  # Get via GET /integrations

# === TikTok post defaults ===
TIKTOK_PRIVACY_LEVEL=SELF_ONLY    # draft-safe: SELF_ONLY
TIKTOK_ALLOW_COMMENTS=true
TIKTOK_ALLOW_DUET=false
TIKTOK_ALLOW_STITCH=false
TIKTOK_AI_LABEL=true              # REQUIRED when images are AI-generated

# === Product defaults (can be overridden per brief) ===
PRODUCT_NAME=The Ultimate AI Business Starter Kit
PRODUCT_URL=https://valorpromotionsagents.com/starter-kit
PRODUCT_PRICE=$42

# === Optional: Slack notification ===
SLACK_WEBHOOK_URL=               # Leave blank to disable
